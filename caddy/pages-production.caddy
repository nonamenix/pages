pages.live4.dev {
  encode zstd gzip
  import /opt/monitoring/caddy/access-log.caddy

  @uploads path /uploads /uploads/*
  handle @uploads {
    header X-Content-Type-Options "nosniff"
    reverse_proxy 127.0.0.1:4351
  }

  @preview path /__preview /__preview/*
  handle @preview {
    header {
      Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
      Cache-Control "no-store"
      X-Robots-Tag "noindex, nofollow, noarchive"
    }
    reverse_proxy 127.0.0.1:4352
  }

  @admin path /admin /admin/* /content-manager /content-manager/* /content-type-builder /content-type-builder/* /content-releases /content-releases/* /email /email/* /i18n /i18n/* /review-workflows /review-workflows/* /upload /upload/* /users-permissions /users-permissions/*
  handle @admin {
    request_body {
      max_size 11MB
    }
    header {
      Cache-Control "no-store"
      X-Robots-Tag "noindex, nofollow, noarchive"
    }
    reverse_proxy 127.0.0.1:4351
  }

  @health path /_health /_health/*
  handle @health {
    respond 404
  }

  @api path /api /api/*
  handle @api {
    @article_api path /api/articles /api/articles/*
    handle @article_api {
      @missing_bearer not header Authorization "Bearer *"
      header {
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow, noarchive"
      }
      header @missing_bearer WWW-Authenticate "Bearer"
      respond @missing_bearer 401
      reverse_proxy 127.0.0.1:4351
    }
    handle {
      respond 404
    }
  }

  @mcp path /mcp /mcp/*
  handle @mcp {
    respond 404
  }

  handle {
    root * /srv/pages-live4dev/current
    header Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru https://yastatic.net; connect-src 'self' https://mc.yandex.ru wss://mc.yandex.ru https://mc.webvisor.com https://mc.webvisor.org wss://mc.webvisor.com wss://mc.webvisor.org; style-src 'self'; img-src 'self' data: https://mc.yandex.ru https://mc.webvisor.com https://mc.webvisor.org https://yastatic.net; child-src blob: https://mc.yandex.ru; frame-src blob: https://mc.yandex.ru; object-src 'none'; base-uri 'none'; frame-ancestors 'self' https://metrika.yandex.ru https://analytics.yandex.ru https://metr.yandex.ru https://metrica.yandex.ru https://metrika.ya.ru; form-action 'none'; upgrade-insecure-requests"
    try_files {path} {path}/index.html
    file_server
  }

  handle_errors {
    @not_found expression {http.error.status_code} == 404
    handle @not_found {
      root * /srv/pages-live4dev/current
      rewrite * /404.html
      header Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
      file_server
    }
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    -Server
  }
}
