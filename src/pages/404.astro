---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Страница не найдена" canonical={null} noindex={true}>
  <section class="not-found shell--reading">
    <p class="eyebrow">Ошибка 404</p>
    <h1>Такой страницы нет.</h1>
    <p>Возможно, статья была перемещена или снята с публикации.</p>
    <a class="text-link" href="/">Вернуться к публикациям →</a>
  </section>
</BaseLayout>
