---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPublishedOn, getArticles } from '../lib/articles.mjs';
import { renderBlocks } from '../lib/blocks.mjs';
import EditorShell from '../components/EditorShell.astro';
import { articleVersion } from '../lib/editor-blocks.mjs';

export async function getStaticPaths() {
  return (await getArticles()).map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const canonical = new URL(`${article.slug}/`, Astro.site).href;
const body = renderBlocks(article.body, {
  mediaBaseUrl: process.env.MEDIA_PUBLIC_BASE_URL || 'https://pages.live4.dev/uploads',
});
const coverAlt = article.cover?.alternativeText || article.title;
---
<BaseLayout
  title={article.title}
  description={article.excerpt}
  language={article.language}
  canonical={canonical}
  image={article.cover?.url}
  noindex={article.draft}
  ogType="article"
  telegraph
>
  {article.draft && <div class="draft-banner" role="status">Предпросмотр неопубликованного черновика</div>}
  <section class="telegraph-page" data-pages-root data-mode="article" data-slug={article.slug} data-preview={String(article.draft)} data-content-version={await articleVersion(article)}>
    <nav class="page-nav" aria-label="Навигация">
      <a href="/">← Все статьи</a>
    </nav>
    <article data-read-view>
    <header class="article-header telegraph-header">
      <h1>{article.title}</h1>
      <p class="article-deck">{article.excerpt}</p>
      <address class="telegraph-meta">
        {article.author && <span>{article.author}</span>}
        <time datetime={article.publishedOn}>{formatPublishedOn(article.publishedOn, article.language)}</time>
        <span>{article.readingMinutes} мин чтения</span>
      </address>
    </header>

    {article.cover && (
      <figure class="article-cover">
        <img src={article.cover.url} alt={coverAlt} width={article.cover.width || undefined} height={article.cover.height || undefined} />
        {article.cover.caption && <figcaption>{article.cover.caption}</figcaption>}
      </figure>
    )}

    <div class="article-body telegraph-body" set:html={body} />
    </article>
    {!article.draft && <aside class="page-actions"><button class="telegraph-button" data-edit type="button" hidden>Редактировать</button><p data-session-status class="editor-status" role="status" hidden></p></aside>}
    <div data-editor-host></div>
    {!article.draft && <EditorShell />}
  </section>
</BaseLayout>
<script>import '../scripts/pages.mjs';</script>
