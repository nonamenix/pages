---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  language?: 'ru' | 'en';
  canonical?: string | null;
  image?: string | null;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  telegraph?: boolean;
}

const {
  title = 'Pages',
  description = 'Статьи, заметки и длинные тексты.',
  language = 'ru',
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  image = null,
  noindex = false,
  ogType = 'website',
  telegraph = false,
} = Astro.props;
const documentTitle = title === 'Pages' ? 'Pages — pages.live4.dev' : `${title} — Pages`;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7faf8" />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <title>{documentTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Pages" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {!noindex && <script is:inline src="/metrika.js" defer></script>}
  </head>
  <body id="top" class:list={{ 'telegraph-layout': telegraph }}>
    {!noindex && (
      <noscript>
        <div class="metrika-noscript" aria-hidden="true">
          <img src="https://mc.yandex.ru/watch/111762995" width="1" height="1" alt="" />
        </div>
      </noscript>
    )}
    <a class="skip-link" href="#content">К содержанию</a>
    <header class="site-header">
      <div class="site-header__inner content-width">
        <div class="site-brand">
          <a class="brand" href="https://live4.dev/" aria-label="live4.dev — на главную">
            <svg class="brand-symbol" viewBox="0 0 32 28" fill="none" aria-hidden="true">
              <path d="M2 10h6l5-5h6l5 5h6M2 17h6l5-5h6l5 5h6M2 24h6l5-5h6l5 5h6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            <span>live4.dev</span>
          </a>
          <span class="brand-separator" aria-hidden="true">/</span>
          <a class="brand-section" href="/">Pages</a>
        </div>
        <nav class="site-navigation" aria-label="Основная навигация">
          <a href="https://books.live4.dev/">Книги</a>
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Статьи</a>
          <a href="/new" data-create hidden>Написать</a>
          <a href="/admin/auth/login" data-login target="_blank" rel="noopener">Войти</a>
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer content-width">
      <a class="footer-brand" href="https://live4.dev/">live4.dev</a>
      <span>Pages — статьи, заметки и длинные тексты.</span>
      <a class="back-to-top" href="#top">Наверх</a>
    </footer>
  </body>
</html>
